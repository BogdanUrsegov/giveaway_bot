# Required
BOT_TOKEN=123456:replace-me
ADMIN_IDS=123456789

# Storage and runtime
DB_PATH=/app/data/giveaways.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Paid random-draw mode is deliberately disabled by default.
# Enable only after checking platform rules and applicable laws.
PAID_GIVEAWAYS_ENABLED=false
# Paid chance-based draws remain fail-closed until the operator has completed
# platform/legal review for every jurisdiction in which the draw is offered.
LEGAL_REVIEW_CONFIRMED=false
LEGAL_REVIEW_REFERENCE=
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=1

# Optional: general subscription prompt on /start
REQUIRED_CHANNEL_URL=

# Optional support contact shown in /paysupport
SUPPORT_CONTACT=@your_support
